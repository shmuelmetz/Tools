/* Developed with AI assistance from Claude (Anthropic) -- 16 Nov 2026 */
/* stamp-pfx-credits.rex
 *
 * Puts the acknowledgements in a credits file into each THE prefix
 * macro named, as a comment block between marker lines.  An existing
 * block is replaced; a macro with no block gets one after its first
 * comment (the header, which ends with a line holding only the
 * comment end).  The macro is rewritten only if the block changes.
 *
 * Usage:
 *   rexx stamp-pfx-credits.rex credits-file macro [macro ...]
 *
 * Arguments:
 *   credits-file  plain text, one comment line per line
 *   macro         a THE macro, e.g. out\the\pfxrexx.the
 *
 * Exit: 0 success, 1 usage or file error.
 *
 * Author: Seymour J. Metz (H: Shmuel)
 * Repo:   https://github.com/shmuelmetz/Personal
 */

use arg argLine
if argLine~words < 2 then do
    say 'Usage: rexx stamp-pfx-credits.rex credits-file macro [macro ...]'
    exit 1
end

credits = readLines(argLine~word(1))
if credits == .nil then exit 1

block = .Array~new
block~append('/* BEGIN CREDITS -- generated by stamp-pfx-credits.rex from')
block~append('   pfx-credits.txt; edit that file, not this block.')
do line over credits
    block~append('  ' line)
end
block~append('   END CREDITS */')

status = 0
do i = 2 to argLine~words
    if \stampMacro(argLine~word(i), block) then status = 1
end
exit status

::routine readLines
    use strict arg path
    if stream(path, 'C', 'QUERY EXISTS') == '' then do
        say 'ERROR: not found:' path
        return .nil
    end
    s = .Stream~new(path)
    s~open('READ')
    lines = s~arrayIn
    s~close
    return lines

::routine stampMacro
    use strict arg path, block
    old = readLines(path)
    if old == .nil then return .false

    begin = 0; finish = 0; headerEnd = 0
    do n = 1 to old~items
        line = old[n]
        if begin = 0, line~abbrev('/* BEGIN CREDITS') then begin = n
        if begin > 0, finish = 0, line~strip == 'END CREDITS */' then finish = n
        if headerEnd = 0, line~strip == '*/' then headerEnd = n
    end
    if begin > 0, finish = 0 then do
        say 'ERROR: unterminated credits block in' path
        return .false
    end

    new = .Array~new
    if begin > 0 then do
        do n = 1 to begin - 1;          new~append(old[n]); end
        do line over block;             new~append(line);   end
        do n = finish + 1 to old~items; new~append(old[n]); end
    end
    else do
        if headerEnd = 0 then do
            say 'ERROR: no header comment end in' path
            return .false
        end
        do n = 1 to headerEnd;            new~append(old[n]); end
        new~append('')
        do line over block;               new~append(line);   end
        do n = headerEnd + 1 to old~items; new~append(old[n]); end
    end

    if new~makeString == old~makeString then do
        say 'unchanged:' path
        return .true
    end
    s = .Stream~new(path)
    s~command('OPEN WRITE REPLACE')
    do line over new
        s~lineout(line)
    end
    s~close
    say 'stamped:' path
    return .true
