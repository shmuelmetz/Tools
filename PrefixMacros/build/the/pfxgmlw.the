/* Developed with AI assistance from Claude Opus 5.5 (Anthropic) -- 17 Nov 2026 */
/* PFXGMLW and PFXGMLSS implement XEDIT prefix commands for GML markup
   in SCRIPT files: PFXGMLW for Waterloo GML, PFXGMLSS for the DCF GML
   Starter Set.  Both are generated from this source and a definition
   (lang\gml.pfx, lang\dcfgml.pfx).  The user's profile for the file
   type, e.g., SCRIPT, issues one command for the dialect in use:
     SET PREFIX SYNONYM :      PFXGMLW
   or
     SET PREFIX SYNONYM :      PFXGMLSS

   The first non-numeric operand is the GML command, e.g., :H1 inserts
   a level one heading before the line.  A count may precede the
   command or follow it; for H, HP, I and IH the number that follows
   is the level:
     :P      paragraph            3:LI   three list items
     :H1     level one heading    :H 1   the same
     :HP2    highlighted phrase   :HP2 3 three of them
*/

/* BEGIN CREDITS -- generated by stamp-pfx-credits.rex from
   pfx-credits.txt; edit that file, not this block.
   Acknowledgements
   Thanks to Adrian Sutherland and the cREXX project for help with the
   compatibility fixes for THE and with the cREXX port.
   END CREDITS */

/*
   Variable usage:
   Ccol          Cursor column
   Cline         Cursor line
   Command_name  Name of the GML prefix command
   Count         Repetition count
   Eline         Line number of end
   Iline         Line after which the template goes
   Indent        Indentation of inserted text (none for GML)
   Level         Level operand of H, HP, I and IH
   Level_cmds    Commands that take a level, with minimum abbreviations
   Pad           Pad for insertion (none for GML)
   Pline         Line number of prefix command
*/

/* Initial housekeeping */

trace n
/* trace ?i */
debug = 0

Def_env = address()
if Def_env = THE then do
   parse upper source opsys calltype path
   parse upper arg Pref Synonym Func Pline Op1 Op2 Op3 .
   if Func = CLEAR then exit 0
   end
else do
   parse upper source opsys calltype fn ft fm Synonym Default_any
   parse upper arg Pref Func Pline Op1 Op2 Op3 .
   end
if debug then do
   say 'address()='Def_env              ,
       'source='source 'opsys='opsys    ,
       'calltype='calltype 'path='path
   parse version version
   say 'parse version='version
   say 'Pref='Pref 'Synonym='Synonym 'Func='Func 'Pline='Pline 'Op1='Op1 'Op2='Op2 'Op3='Op3
   end
':'Pline COMMAND SET PENDING OFF

if Pref <> Prefix then do
   COMMAND EMSG Synonym 'is a prefix macro.'
   exit
   end
Count  = 1
Indent = 0
Pad    = ''
COMMAND PRESERVE
SET IMPOS OFF

/* The commands that take a level: name and minimum abbreviation */
Level_cmds = 'H 1 HP 2 I 1 IH 2'

/* Split the operands: [count] command[level] [level] [count] */
Command_name = ''
Count_given  = 0
Level        = ''
Nums         = ''
Ops          = space(Op1 Op2 Op3)
if Ops = '' then call Error_msg 'Missing GML prefix subcommand'
parse var Ops Word1 Ops
/* a leading count, separate or attached: 3 LI, 3LI */
if datatype(Word1,'W') then do
   Count       = Word1
   Count_given = 1
   parse var Ops Word1 Ops
   end
else do
   i = verify(Word1,'0123456789')
   if i > 1 then do
      Count       = left(Word1,i-1)
      Count_given = 1
      Word1       = substr(Word1,i)
      end
   end
if Word1 = '' then call Error_msg 'Missing GML prefix subcommand'
/* trailing digits on the command: H1, HP2 */
i = verify(Word1,'0123456789','M')
if i > 1 then do
   Nums  = substr(Word1,i)
   Word1 = left(Word1,i-1)
   if datatype(Nums,'W') = 0 then
      call Error_msg 'Invalid GML prefix subcommand'
   end
Command_name = Word1
/* separate numbers after the command */
do while Ops <> ''
   parse var Ops w Ops
   if datatype(w,'W') = 0 then call Error_msg 'Unexpected operand' w
   Nums = Nums w
   end
/* the first number is the level of a level command; a remaining
   number is the count */
if Takes_level(Command_name) then do
   if Nums = '' then call Error_msg 'Missing level'
   parse var Nums Level Nums
   end
Nums = space(Nums)
if Nums <> '' then do
   if Count_given | words(Nums) > 1 then call Error_msg 'Too many operands'
   Count = Nums
   end

if datatype(Count,'W') = 0 then call Error_msg 'Invalid repetition count'
if Count < 1 | Count > 99 then call Error_msg 'Expected count from 1 to 99'

if Def_env = XEDIT then
   'COMMAND          EXTRACT /FLSCREEN /LINE'
else
   'COMMAND          EXTRACT           /LINE'
'COMMAND :'Pline 'EXTRACT /CURSOR /CURLINE'

/* Mainline logic: the template goes before the command's line */

select
   when Func = SET | Func = SHADOW then do Pass = 1 to Count
      if Pline = 0 then do
         /* on the top-of-file line: insert at the top */
         Iline = 0
         Cline = 1
         end
      else do
         Iline = Pline - 1
         Cline = Pline
         end
      Eline = Cline + 1
      COMMAND SET SCOPE ALL
      Ccol  = 0
      select
         when abbrev('BIB',Command_name,3) then do
            Eline  = Cline + 3
            First  = ':BIB ID='
            Ccol   = Indent + 1 + 8
            COMMAND ':'Iline INPUT Pad || First
            COMMAND          INPUT Pad || 'name, initials'
            COMMAND          INPUT Pad || ':CIT title'
            COMMAND          INPUT Pad || ':ECIT.'
            end
         when abbrev('BIBID',Command_name,4) then do
            Eline  = Cline + 0
            First  = ':BIBID REFID=.'
            Ccol   = Indent + 1 + 13
            COMMAND ':'Iline INPUT Pad || First
            end
         when abbrev('BIBREF',Command_name,4) then do
            Eline  = Cline + 0
            First  = ':BIBREF REFID= PP=''.-.''.'
            Ccol   = Indent + 1 + 14
            COMMAND ':'Iline INPUT Pad || First
            end
         when abbrev('BL',Command_name,2) then do
            Eline  = Cline + 1
            First  = ':BL'
            Ccol   = Indent + 1 + 4
            COMMAND ':'Iline INPUT Pad || First
            COMMAND          INPUT Pad || ':EBL'
            end
         when abbrev('BOX',Command_name,3) then do
            Eline  = Cline + 1
            First  = ':BOX.'
            Ccol   = Indent + 1 + 5
            COMMAND ':'Iline INPUT Pad || First
            COMMAND          INPUT Pad || ':EBOX.'
            end
         when abbrev('CIT',Command_name,3) then do
            Eline  = Cline + 1
            First  = ':CIT.'
            Ccol   = Indent + 1 + 5
            COMMAND ':'Iline INPUT Pad || First
            COMMAND          INPUT Pad || ':ECIT.'
            end
         when abbrev('DD',Command_name,2) then do
            Eline  = Cline + 0
            First  = ':DD.description'
            Ccol   = Indent + 1 + 4
            COMMAND ':'Iline INPUT Pad || First
            end
         when abbrev('DDH',Command_name,3) then do
            Eline  = Cline + 0
            First  = ':DDH.description heading'
            Ccol   = Indent + 1 + 4
            COMMAND ':'Iline INPUT Pad || First
            end
         when abbrev('DIST',Command_name,4) then do
            Eline  = Cline + 1
            First  = ':DIST.'
            Ccol   = Indent + 1 + 6
            COMMAND ':'Iline INPUT Pad || First
            COMMAND          INPUT Pad || 'list'
            end
         when abbrev('DISTRIB',Command_name,5) then do
            Eline  = Cline + 3
            First  = ':DISTRIB'
            Cline  = Cline + 1
            Ccol   = Indent + 1 + 0 + 6
            COMMAND ':'Iline INPUT Pad || First
            COMMAND          INPUT Pad || ':DIST.type'
            COMMAND          INPUT Pad || 'list'
            COMMAND          INPUT Pad || ':EDISTRIB'
            end
         when abbrev('DL',Command_name,2) then do
            Eline  = Cline + 5
            First  = ':DL'
            Ccol   = Indent + 1 + 4
            COMMAND ':'Iline INPUT Pad || First
            COMMAND          INPUT Pad || ':DTH.term heading'
            COMMAND          INPUT Pad || ':DDH.description heading'
            COMMAND          INPUT Pad || ':DT.term'
            COMMAND          INPUT Pad || ':DD.description'
            COMMAND          INPUT Pad || ':EDL.'
            end
         when abbrev('DT',Command_name,2) then do
            Eline  = Cline + 1
            First  = ':DT.term'
            Ccol   = Indent + 1 + 4
            COMMAND ':'Iline INPUT Pad || First
            COMMAND          INPUT Pad || ':DD.description'
            end
         when abbrev('DTH',Command_name,3) then do
            Eline  = Cline + 0
            First  = ':DTH.term heading'
            Ccol   = Indent + 1 + 4
            COMMAND ':'Iline INPUT Pad || First
            end
         when abbrev('EN',Command_name,2) then do
            Eline  = Cline + 1
            First  = ':EN.'
            Ccol   = Indent + 1 + 4
            COMMAND ':'Iline INPUT Pad || First
            COMMAND          INPUT Pad || ':EEN.'
            end
         when abbrev('FIG',Command_name,3) then do
            Eline  = Cline + 4
            First  = ':FIG'
            Ccol   = Indent + 1 + 5
            COMMAND ':'Iline INPUT Pad || First
            COMMAND          INPUT Pad || 'put text here'
            COMMAND          INPUT Pad || ':FIGCAP.'
            COMMAND          INPUT Pad || ':FIGDESC.'
            COMMAND          INPUT Pad || ':EFIG'
            end
         when abbrev('FIGID',Command_name,4) then do
            Eline  = Cline + 0
            First  = ':FIGID REFID=.'
            Ccol   = Indent + 1 + 13
            COMMAND ':'Iline INPUT Pad || First
            end
         when abbrev('FIGREF',Command_name,4) then do
            Eline  = Cline + 0
            First  = ':FIGREF REFID=.'
            Ccol   = Indent + 1 + 14
            COMMAND ':'Iline INPUT Pad || First
            end
         when abbrev('FN',Command_name,2) then do
            Eline  = Cline + 1
            First  = ':FN.'
            Ccol   = Indent + 1 + 4
            COMMAND ':'Iline INPUT Pad || First
            COMMAND          INPUT Pad || ':EFN.'
            end
         when abbrev('FNREF',Command_name,4) then do
            Eline  = Cline + 0
            First  = ':FNREF REFID=.'
            Ccol   = Indent + 1 + 13
            COMMAND ':'Iline INPUT Pad || First
            end
         when abbrev('GD',Command_name,2) then do
            Eline  = Cline + 0
            First  = ':GD.definition'
            Ccol   = Indent + 1 + 4
            COMMAND ':'Iline INPUT Pad || First
            end
         when abbrev('GDOC',Command_name,4) then do
            Eline  = Cline + 27
            First  = '.IM GMLgdoc'
            Cline  = Cline + 4
            Ccol   = Indent + 1 + 0 + 7
            COMMAND ':'Iline INPUT Pad || First
            COMMAND          INPUT Pad || ':GDOC.'
            COMMAND          INPUT Pad || ':FRONTM'
            COMMAND          INPUT Pad || ':TITLEP'
            COMMAND          INPUT Pad || ':TITLE.text'
            COMMAND          INPUT Pad || ':AUTHOR.name'
            COMMAND          INPUT Pad || ':ADDRESS'
            COMMAND          INPUT Pad || ':ALINE.'
            COMMAND          INPUT Pad || ':EADDRESS'
            COMMAND          INPUT Pad || ':DOCNUM.number'
            COMMAND          INPUT Pad || ':DATE.'
            COMMAND          INPUT Pad || ':COPYRIGHT.'
            COMMAND          INPUT Pad || ':ETITLEP'
            COMMAND          INPUT Pad || ':ABSTRACT.heading'
            COMMAND          INPUT Pad || 'text of abstract'
            COMMAND          INPUT Pad || ':EABSTRACT'
            COMMAND          INPUT Pad || ':PREFACE.heading'
            COMMAND          INPUT Pad || 'text of Preface'
            COMMAND          INPUT Pad || ':EPREFACE'
            COMMAND          INPUT Pad || ':TOC.'
            COMMAND          INPUT Pad || ':FIGLIST.'
            COMMAND          INPUT Pad || ':TABLIST.'
            COMMAND          INPUT Pad || ':EFRONTM'
            COMMAND          INPUT Pad || ':BODY'
            COMMAND          INPUT Pad || ':BACKM'
            COMMAND          INPUT Pad || ':INDEX.'
            COMMAND          INPUT Pad || ':EBACKM'
            COMMAND          INPUT Pad || ':EGDOC.'
            end
         when abbrev('GL',Command_name,2) then do
            Eline  = Cline + 1
            First  = ':GL'
            Ccol   = Indent + 1 + 4
            COMMAND ':'Iline INPUT Pad || First
            COMMAND          INPUT Pad || ':EGL.'
            end
         when abbrev('GT',Command_name,2) then do
            Eline  = Cline + 0
            First  = ':GT.phrase'
            Ccol   = Indent + 1 + 4
            COMMAND ':'Iline INPUT Pad || First
            end
         when abbrev('HDREF',Command_name,3) then do
            Eline  = Cline + 0
            First  = ':HDREF REFID=.'
            Ccol   = Indent + 1 + 13
            COMMAND ':'Iline INPUT Pad || First
            end
         when abbrev('H',Command_name,1) then do
            if Level < 0 | Level > 6 then
               call Error_msg 'Expected level from 0 to 6'
            Eline  = Cline + 0
            First  = ':H' || Level || '.'
            Ccol   = Indent + 1 + 4
            COMMAND ':'Iline INPUT Pad || First
            end
         when abbrev('HP',Command_name,2) then do
            if Level < 0 | Level > 3 then
               call Error_msg 'Expected level from 0 to 3'
            Eline  = Cline + 1
            First  = ':HP' || Level || '.'
            Ccol   = Indent + 1 + 5
            COMMAND ':'Iline INPUT Pad || First
            COMMAND          INPUT Pad || ':EHP' || Level || '.'
            end
         when abbrev('I',Command_name,1) then do
            if Level < 1 | Level > 3 then
               call Error_msg 'Expected level from 1 to 3'
            Eline  = Cline + 0
            First  = ':I' || Level || '.'
            Ccol   = Indent + 1 + 4
            COMMAND ':'Iline INPUT Pad || First
            end
         when abbrev('IH',Command_name,2) then do
            if Level < 1 | Level > 3 then
               call Error_msg 'Expected level from 1 to 3'
            Eline  = Cline + 0
            First  = ':IH' || Level || '.'
            Ccol   = Indent + 1 + 5
            COMMAND ':'Iline INPUT Pad || First
            end
         when abbrev('LETTER',Command_name,3) then do
            Eline  = Cline + 14
            First  = '.IM GMLlet'
            Cline  = Cline + 4
            Ccol   = Indent + 1 + 0 + 4
            COMMAND ':'Iline INPUT Pad || First
            COMMAND          INPUT Pad || ':GDOC.'
            COMMAND          INPUT Pad || ':DATE'
            COMMAND          INPUT Pad || ':DOCNUM.number'
            COMMAND          INPUT Pad || ':TO.name'
            COMMAND          INPUT Pad || 'address'
            COMMAND          INPUT Pad || ':ATTN.name'
            COMMAND          INPUT Pad || ':SUBJECT.text'
            COMMAND          INPUT Pad || ':OPEN.salutation'
            COMMAND          INPUT Pad || 'body'
            COMMAND          INPUT Pad || ':CLOSE.salutation'
            COMMAND          INPUT Pad || 'name'
            COMMAND          INPUT Pad || 'title'
            COMMAND          INPUT Pad || ':ECLOSE'
            COMMAND          INPUT Pad || ':EGDOC.'
            end
         when abbrev('LI',Command_name,2) then do
            Eline  = Cline + 0
            First  = ':LI.'
            Ccol   = Indent + 1 + 4
            COMMAND ':'Iline INPUT Pad || First
            end
         when abbrev('LIH',Command_name,3) then do
            Eline  = Cline + 0
            First  = ':LIH.'
            Ccol   = Indent + 1 + 4
            COMMAND ':'Iline INPUT Pad || First
            end
         when abbrev('LQ',Command_name,2) then do
            Eline  = Cline + 1
            First  = ':LQ.'
            Ccol   = Indent + 1 + 4
            COMMAND ':'Iline INPUT Pad || First
            COMMAND          INPUT Pad || ':ELQ.'
            end
         when abbrev('MEMO',Command_name,3) then do
            Eline  = Cline + 14
            First  = '.IM GMLmemo'
            Cline  = Cline + 5
            Ccol   = Indent + 1 + 0 + 0
            COMMAND ':'Iline INPUT Pad || First
            COMMAND          INPUT Pad || ':GDOC.'
            COMMAND          INPUT Pad || ':DATE'
            COMMAND          INPUT Pad || ':DISTRIB'
            COMMAND          INPUT Pad || ':DIST.To'
            COMMAND          INPUT Pad || 'list'
            COMMAND          INPUT Pad || ':DIST.From'
            COMMAND          INPUT Pad || 'list'
            COMMAND          INPUT Pad || ':DIST.Copies'
            COMMAND          INPUT Pad || 'list'
            COMMAND          INPUT Pad || ':EDISTRIB'
            COMMAND          INPUT Pad || ':SUBJECT.text'
            COMMAND          INPUT Pad || ':ESUBJECT'
            COMMAND          INPUT Pad || 'body'
            COMMAND          INPUT Pad || ':EGDOC.'
            end
         when abbrev('NOTE',Command_name,4) then do
            Eline  = Cline + 1
            First  = ':NOTE.'
            Ccol   = Indent + 1 + 6
            COMMAND ':'Iline INPUT Pad || First
            COMMAND          INPUT Pad || ':ENOTE.'
            end
         when abbrev('OL',Command_name,2) then do
            Eline  = Cline + 2
            First  = ':OL'
            Ccol   = Indent + 1 + 4
            COMMAND ':'Iline INPUT Pad || First
            COMMAND          INPUT Pad || ':LI.'
            COMMAND          INPUT Pad || ':EOL.'
            end
         when abbrev('P',Command_name,1) then do
            Eline  = Cline + 0
            First  = ':P.'
            Ccol   = Indent + 1 + 3
            COMMAND ':'Iline INPUT Pad || First
            end
         when abbrev('PSC',Command_name,3) then do
            Eline  = Cline + 2
            First  = ':PSC PROC='' '''
            Ccol   = Indent + 1 + 11
            COMMAND ':'Iline INPUT Pad || First
            COMMAND          INPUT Pad || 'contents'
            COMMAND          INPUT Pad || ':EPSC.'
            end
         when abbrev('Q',Command_name,1) then do
            Eline  = Cline + 1
            First  = ':Q.'
            Ccol   = Indent + 1 + 3
            COMMAND ':'Iline INPUT Pad || First
            COMMAND          INPUT Pad || ':EQ.'
            end
         when abbrev('SL',Command_name,2) then do
            Eline  = Cline + 2
            First  = ':SL'
            Ccol   = Indent + 1 + 4
            COMMAND ':'Iline INPUT Pad || First
            COMMAND          INPUT Pad || ':LI.'
            COMMAND          INPUT Pad || ':ESL.'
            end
         when abbrev('TAB',Command_name,3) then do
            Eline  = Cline + 5
            First  = ':TAB'
            Ccol   = Indent + 1 + 5
            COMMAND ':'Iline INPUT Pad || First
            COMMAND          INPUT Pad || ':TABCAP.'
            COMMAND          INPUT Pad || ':TABDESC.'
            COMMAND          INPUT Pad || ':ETABDESC'
            COMMAND          INPUT Pad || 'put text here'
            COMMAND          INPUT Pad || ':ETAB.'
            end
         when abbrev('TABID',Command_name,4) then do
            Eline  = Cline + 0
            First  = ':TABID REFID=.'
            Ccol   = Indent + 1 + 13
            COMMAND ':'Iline INPUT Pad || First
            end
         when abbrev('TABREF',Command_name,4) then do
            Eline  = Cline + 0
            First  = ':TABREF REFID=.'
            Ccol   = Indent + 1 + 14
            COMMAND ':'Iline INPUT Pad || First
            end
         when abbrev('UL',Command_name,2) then do
            Eline  = Cline + 2
            First  = ':UL'
            Ccol   = Indent + 1 + 4
            COMMAND ':'Iline INPUT Pad || First
            COMMAND          INPUT Pad || ':LI.'
            COMMAND          INPUT Pad || ':EUL.'
            end
         when abbrev('XMP',Command_name,3) then do
            Eline  = Cline + 1
            First  = ':XMP.'
            Ccol   = Indent + 1 + 5
            COMMAND ':'Iline INPUT Pad || First
            COMMAND          INPUT Pad || ':EXMP.'
            end
         otherwise
            call Error_msg 'Unknown GML prefix subcommand'
         end
      end
   when Func = CLEAR then do
      /* Not needed at this time */
      COMMAND RESTORE
      exit
      end
   otherwise do
      COMMAND EMSG 'Func='Func'? Should be SET, SHADOW or CLEAR.'
      COMMAND RESTORE
      exit
      end
   end

/* Final housekeeping */

COMMAND RESTORE
if Cline > 0 & Ccol > 0 then do
   COMMAND ':'Cline CURSOR FILE Cline Ccol PRIORITY 30
   if Def_env = XEDIT then do
      /* THE doesn't have EXTRACT|QUERY|SET FLSCREEN */
      if Line.1 > Pline then
         Flscreen.1 = Flscreen.1 + Count * (Eline - Iline)
      if Cline < Flscreen.1 | Eline > Flscreen.2 then do
         select
            when abbrev(CURLINE.1,M) then
               Pline = Cline
            when CURLINE.1 < 0 then
               Pline = max(Cline,Eline+3+CURLINE.1)
            otherwise
               nop
            end
         push ':'Pline CURSOR FILE Cline Ccol PRIORITY 70
         end
      end
   end
COMMAND REFRESH
exit

/* Subroutines */

Takes_level:
   /* 1 if arg(1) abbreviates a command that takes a level */
   procedure expose Level_cmds
   parse arg Name
   do i = 1 to words(Level_cmds) by 2
      if abbrev(word(Level_cmds,i), Name, word(Level_cmds,i+1)) then
         return 1
      end
   return 0

Error_msg:
   Text = left(':'space(Op1 Op2 Op3,0), 6)
   if debug then say arg(1)':' Op1 Op2 Op3
   COMMAND EMSG arg(1)':' Op1 Op2 Op3
   COMMAND RESTORE
   COMMAND ':'Pline SET PENDING ERROR Text
   exit 1
