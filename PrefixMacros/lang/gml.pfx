* Developed with AI assistance from Claude Opus 5.5 (Anthropic) -- 17 Nov 2026
* gml.pfx -- GML definition for the prefix-macro framework (phase B)
* Transcribed from his listing of PFXGML XEDIT (created 13 Aug 1985,
* edited 30 Jun 1987; printed 22 Aug 1989): "Prefix subcommands of XEDIT
* for filetype SCRIPT". Descriptions are his, from Prefix.Macros.tex.
*
* GML works differently from REXX and HLASM:
* - one synonym, ":", and the command is the first non-numeric operand
*   (§dispatch operand);
* - the lines go in before the command's line (§insert before);
* - no indentation; a cursor offset is from column 1;
* - H, HP, I and IH take a level, %n in the text (§level low high).
§lang       GML
§macro      PFXGMLW
§source     gml
§dispatch   operand
§insert     before
*
§cmd        BIB      §min 3  §desc Insert bibliography entry: :BIB ID= name, initials :CIT title :ECIT.
§first      :BIB ID=                       §cursor 8
§row        text=name, initials
§row        text=:CIT title
§row        text=:ECIT.
§cmd        BIBID    §min 4  §desc :BIBID REFID=
§first      :BIBID REFID=.                 §cursor 13
§cmd        BIBREF   §min 4  §desc :BIBREF REFID= PP='.-.'.
§first      :BIBREF REFID= PP='.-.'.       §cursor 14
§cmd        BL       §min 2  §desc :BL :EBL
§first      :BL                            §cursor 4
§row        text=:EBL
§cmd        BOX      §min 3  §desc Insert box :BOX :EBOX
§first      :BOX.                          §cursor 5
§row        text=:EBOX.
§cmd        CIT      §min 3  §desc Insert title citation :CIT :ECIT
§first      :CIT.                          §cursor 5
§row        text=:ECIT.
§cmd        DD       §min 2  §desc Insert definition description
§first      :DD.description                §cursor 4
§cmd        DDH      §min 3  §desc Insert definition description header
§first      :DDH.description heading       §cursor 4
§cmd        DIST     §min 4  §desc
§first      :DIST.                         §cursor 6
§row        text=list
§cmd        DISTRIB  §min 5  §desc
§first      :DISTRIB
§row        text=:DIST.type                §cursor 6
§row        text=list
§row        text=:EDISTRIB
§cmd        DL       §min 2  §desc Insert definition list
§first      :DL                            §cursor 4
§row        text=:DTH.term heading
§row        text=:DDH.description heading
§row        text=:DT.term
§row        text=:DD.description
§row        text=:EDL.
§cmd        DT       §min 2  §desc Insert definition term
§first      :DT.term                       §cursor 4
§row        text=:DD.description
§cmd        DTH      §min 3  §desc Insert definition term header
§first      :DTH.term heading              §cursor 4
§cmd        EN       §min 2  §desc
§first      :EN.                           §cursor 4
§row        text=:EEN.
§cmd        FIG      §min 3  §desc Insert figure
§first      :FIG                           §cursor 5
§row        text=put text here
§row        text=:FIGCAP.
§row        text=:FIGDESC.
§row        text=:EFIG
§cmd        FIGID    §min 4  §desc
§first      :FIGID REFID=.                 §cursor 13
§cmd        FIGREF   §min 4  §desc Insert figure reference
§first      :FIGREF REFID=.                §cursor 14
§cmd        FN       §min 2  §desc Insert footnote
§first      :FN.                           §cursor 4
§row        text=:EFN.
§cmd        FNREF    §min 4  §desc Insert footnote reference
§first      :FNREF REFID=.                 §cursor 13
§cmd        GD       §min 2  §desc Insert glossary definition
§first      :GD.definition                 §cursor 4
§cmd        GDOC     §min 4  §desc Insert general document
§first      .IM GMLgdoc
§row        text=:GDOC.
§row        text=:FRONTM
§row        text=:TITLEP
§row        text=:TITLE.text               §cursor 7
§row        text=:AUTHOR.name
§row        text=:ADDRESS
§row        text=:ALINE.
§row        text=:EADDRESS
§row        text=:DOCNUM.number
§row        text=:DATE.
§row        text=:COPYRIGHT.
§row        text=:ETITLEP
§row        text=:ABSTRACT.heading
§row        text=text of abstract
§row        text=:EABSTRACT
§row        text=:PREFACE.heading
§row        text=text of Preface
§row        text=:EPREFACE
§row        text=:TOC.
§row        text=:FIGLIST.
§row        text=:TABLIST.
§row        text=:EFRONTM
§row        text=:BODY
§row        text=:BACKM
§row        text=:INDEX.
§row        text=:EBACKM
§row        text=:EGDOC.
§cmd        GL       §min 2  §desc Insert glossary list
§first      :GL                            §cursor 4
§row        text=:EGL.
§cmd        GT       §min 2  §desc Insert glossary term
§first      :GT.phrase                     §cursor 4
§cmd        HDREF    §min 3  §desc Insert heading reference
§first      :HDREF REFID=.                 §cursor 13
§cmd        H        §min 1  §desc Insert heading level n, specified as :Hn, n=0-6
§level      0 6
§first      :H%n.                          §cursor 4
§cmd        HP       §min 2  §desc highlighted phrase n, specified as :HPn, n=0-3
§level      0 3
§first      :HP%n.                         §cursor 5
§row        text=:EHP%n.
§cmd        I        §min 1  §desc Insert index entry level n, specified as :In, n=1-3
§level      1 3
§first      :I%n.                          §cursor 4
§cmd        IH       §min 2  §desc Insert index header level n, specified as :IHn, n=1-3
§level      1 3
§first      :IH%n.                         §cursor 5
§cmd        LETTER   §min 3  §desc
§first      .IM GMLlet
§row        text=:GDOC.
§row        text=:DATE
§row        text=:DOCNUM.number
§row        text=:TO.name                  §cursor 4
§row        text=address
§row        text=:ATTN.name
§row        text=:SUBJECT.text
§row        text=:OPEN.salutation
§row        text=body
§row        text=:CLOSE.salutation
§row        text=name
§row        text=title
§row        text=:ECLOSE
§row        text=:EGDOC.
§cmd        LI       §min 2  §desc Insert list item
§first      :LI.                           §cursor 4
§cmd        LIH      §min 3  §desc
§first      :LIH.                          §cursor 4
§cmd        LQ       §min 2  §desc Insert long quote
§first      :LQ.                           §cursor 4
§row        text=:ELQ.
§cmd        MEMO     §min 3  §desc
§first      .IM GMLmemo
§row        text=:GDOC.
§row        text=:DATE
§row        text=:DISTRIB
§row        text=:DIST.To
§row        text=list                      §cursor 0
§row        text=:DIST.From
§row        text=list
§row        text=:DIST.Copies
§row        text=list
§row        text=:EDISTRIB
§row        text=:SUBJECT.text
§row        text=:ESUBJECT
§row        text=body
§row        text=:EGDOC.
§cmd        NOTE     §min 4  §desc Insert note
§first      :NOTE.                         §cursor 6
§row        text=:ENOTE.
§cmd        OL       §min 2  §desc Insert ordered list
§first      :OL                            §cursor 4
§row        text=:LI.
§row        text=:EOL.
§cmd        P        §min 1  §desc Insert paragraph
§first      :P.                            §cursor 3
§cmd        PSC      §min 3  §desc Insert process specific control
§first      :PSC PROC=' '                  §cursor 11
§row        text=contents
§row        text=:EPSC.
§cmd        Q        §min 1  §desc Insert quote
§first      :Q.                            §cursor 3
§row        text=:EQ.
§cmd        SL       §min 2  §desc Insert simple list
§first      :SL                            §cursor 4
§row        text=:LI.
§row        text=:ESL.
§cmd        TAB      §min 3  §desc
§first      :TAB                           §cursor 5
§row        text=:TABCAP.
§row        text=:TABDESC.
§row        text=:ETABDESC
§row        text=put text here
§row        text=:ETAB.
§cmd        TABID    §min 4  §desc
§first      :TABID REFID=.                 §cursor 13
§cmd        TABREF   §min 4  §desc
§first      :TABREF REFID=.                §cursor 14
§cmd        UL       §min 2  §desc Insert unordered list
§first      :UL                            §cursor 4
§row        text=:LI.
§row        text=:EUL.
§cmd        XMP      §min 3  §desc Insert example
§first      :XMP.                          §cursor 5
§row        text=:EXMP.
