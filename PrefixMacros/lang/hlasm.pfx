* hlasm.pfx -- High Level Assembler definition for the prefix-macro
* framework (phase B): the HLASM Toolkit Feature structured programming
* macros (GC26-8710-10, chapter 2).  Format as in rexx.pfx.
*
* The templates are those of the hand-written PFXHLASM they replace,
* text unchanged.  The cursor goes where the user enters something,
* after the constant part (his rule, 17 Nov 2026).  The look-back, the indentation
* rules, and the built-in commands (.., LC, RI, RIC, STAR, UC, UNSTAR)
* stay in src\pfxhlasm.src.
*
* Operands of a variant: - none, * any other, # a number, a keyword and
* its minimum, or (a list of values).  A command with variants but no *
* rejects any other operand.  %op is the operand; %(By_reg) is the BY
* register the macro builds from the second operand (R? if none, Rn
* for a number n, else as given).  :alias. gives other names, each
* with its minimum abbreviation (default: the whole name), matched with
* abbrev() like the command: CASEE, OTHERWISE 5 (OTHER), STRTSRCH 5
* (STRTS).  :cursor. none leaves the cursor alone.
:lang.       HLASM
:macro.      PFXHLASM
:unit.       CASE=2 CASENTRY=2 DO=2 IF=2 SEARCH=2 SELECT=2 WHEN=2
*
* ---- commands ----
:cmd.        ASMLEAVE    :min. 4  :desc. Insert ASMLEAVE
:first.      ASMLEAVE label                    :cursor. 9
:row.        pend=RIC
*
:cmd.        CASE        :min. 4  :desc. Insert CASE
:first.      CASE ?                            :cursor. 5
:row.        pend=RIC indent=CASE text=opcod ,
*
:cmd.        CASENTRY    :min. 5  :desc. Insert CASENTRY block
:alias.      CASEE
:first.      CASENTRY R?,POWER=?,VECTOR=B      :cursor. 10
:row.        indent=CASENTRY text=CASE ?
:row.        pend=RIC indent=CASENTRY+CASE text=opcod ,
:row.        text=ENDCASE ,
*
:cmd.        DO          :min. 2  :desc. Insert DO block
:var.        -           :first. DO ONCE                   :cursor. body
:var.        ONCE 1      :first. DO ONCE                   :cursor. body
:var.        #           :first. DO FROM=(R%op)            :cursor. body
:var.        BY 1        :first. DO FROM=(R?),BY=(%(By_reg)) :cursor. 10
:var.        FOREVER 2   :first. DO INF                    :cursor. body
:var.        INF 1       :first. DO INF                    :cursor. body
:var.        FROM 2      :first. DO FROM=(R?)              :cursor. 10
:var.        UNTIL 1     :first. DO UNTIL=if_option        :cursor. 9
:var.        WHILE 1     :first. DO WHILE=if_option        :cursor. 9
:var.        *           :first. DO %op                    :cursor. body
:row.        pend=RIC indent=DO text=opcod ,
:row.        text=ENDDO ,
*
:cmd.        DOEXIT      :min. 4  :desc. Insert DOEXIT
:first.      DOEXIT test                       :cursor. 7
:row.        pend=RIC
*
:cmd.        ELSE        :min. 4  :desc. Insert ELSE
:first.      ELSE ,                            :cursor. body
:row.        pend=RIC indent=IF text=opcod ,
*
:cmd.        ELSEIF      :min. 5  :desc. Insert ELSEIF
:first.      ELSEIF test                       :cursor. 7
:row.        pend=RIC indent=IF text=opcod ,
*
:cmd.        EXITIF      :min. 5  :desc. Insert EXITIF
:first.      EXITIF if_options                 :cursor. 7
:row.        pend=RIC indent=SEARCH text=opcod ,
:row.        text=ORELSE  ,
:row.        pend=RIC indent=SEARCH text=opcod ,
*
:cmd.        IF          :min. 2  :desc. Insert IF
:var.        -           :first. IF .                      :cursor. 3
:var.        #           :first. IF (%op)                  :cursor. body
:var.        (E EQ GT H L LE LT M N NE NH NL NM NO NP NZ O Z) :first. IF (%op) :cursor. body
:var.        CC 2        :first. IF CC=.                   :cursor. 6
:row.        pend=RIC indent=IF text=opcod ,
:row.        text=ELSEIF .
:row.        pend=RIC indent=IF text=opcod ,
:row.        text=ELSE  ,
:row.        pend=RIC indent=IF text=opcod ,
:row.        text=ENDIF  ,
*
:cmd.        ENDIF       :min. 5  :desc. Insert ENDIF
:first.      ENDIF ,                           :cursor. none
*
:cmd.        ITERATE     :min. 5  :desc. Insert ITERATE
:first.      ITERATE label                     :cursor. 8
*
:cmd.        ORELSE      :min. 5  :desc. Insert ORELSE
:first.      ORELSE  ,                         :cursor. body
:row.        pend=RIC indent=SEARCH text=opcod ,
*
:cmd.        OTHRWISE    :min. 5  :desc. Insert OTHRWISE
:alias.      OTHERWISE 5
:first.      OTHRWISE ,                        :cursor. body
:row.        pend=RIC indent=WHEN text=opcod ,
*
:cmd.        SEARCH      :min. 3  :desc. Insert search block
:alias.      STRTSRCH 5
:first.      STRTSRCH do_options               :cursor. 9
:row.        pend=RIC indent=SEARCH text=opcod ,
:row.        text=EXITIF if_options
:row.        pend=RIC indent=SEARCH text=opcod ,
:row.        text=ORELSE  ,
:row.        pend=RIC indent=SEARCH text=opcod ,
:row.        text=ENDLOOP ,
:row.        pend=RIC indent=SEARCH text=opcod ,
:row.        text=ENDSRCH  ,
*
:cmd.        SELECT      :min. 3  :desc. Insert SELECT block
:first.      SELECT ,
:row.        indent=SELECT text=WHEN if_test   :cursor. 5
:row.        pend=RIC indent=SELECT+WHEN text=opcod ,
:row.        indent=SELECT text=OTHRWISE ,
:row.        pend=RIC indent=SELECT+WHEN text=opcod ,
:row.        text=ENDSEL
*
:cmd.        WHEN        :min. 4  :desc. Insert WHEN clause
:first.      WHEN if_test                      :cursor. 5
:row.        pend=RIC indent=WHEN text=opcod ,
