* dcfgml.pfx -- IBM GML Starter Set definition for the prefix-macro
* framework (phase B), separate from the Waterloo definition (gml.pfx).
* Dialect: Document Composition Facility GML Starter Set Release 4.0
* (SH20-9187-06, Jan 1991); tag syntax from the DCF GML Starter Set
* Quick Reference (SX26-3719-4, March 1985), pages 2-4, and, for RDEF,
* the table tags, TLIST, TNOTE and TREF, from SH20-9187-06 pages
* 88-110.  The Quick Reference summarizes SH20-9187-3, an earlier
* edition; where they differ, SH20-9187-06 governs.  Every tag taken
* from it was checked against SH20-9187-06 (pages 37-115) and the
* templates stand; 4.0 adds only LANGUAGE= on :GDOC.  End tags are the
* E form (:EOL., :EUL., ...), as in the Starter Set.  Sources: see
* BIBLIOGRAPHY.md.
*
* Conventions as in gml.pfx: one synonym, ":", the command is the
* first non-numeric operand (:dispatch. operand); lines go in before
* the command's line (:insert. before); no indentation; a cursor
* offset counts the characters before the cursor; H, HP, I and IH
* take a level, %n in the text (:level. low high).
:lang.       GML
:macro.      PFXGMLSS
:source.     gml
:dispatch.   operand
:insert.     before
*
:cmd.        ABSTRACT :min. 2  :desc. Insert abstract
:first.      :ABSTRACT.
:cmd.        ADDRESS  :min. 2  :desc. Insert address
:first.      :ADDRESS.
:row.        text=:ALINE.address line       :cursor. 7
:row.        text=:EADDRESS.
:cmd.        ALINE    :min. 2  :desc. Insert address line
:first.      :ALINE.address line            :cursor. 7
:cmd.        APPENDIX :min. 2  :desc. Insert appendix section
:first.      :APPENDIX.
:cmd.        AUTHOR   :min. 2  :desc. Insert author name
:first.      :AUTHOR.author name            :cursor. 8
:cmd.        BACKM    :min. 2  :desc. Insert back matter section
:first.      :BACKM.
:cmd.        BODY     :min. 2  :desc. Insert body section
:first.      :BODY.
:cmd.        C        :min. 1  :desc. Insert table cell
:first.      :C.                            :cursor. 3
:cmd.        CIT      :min. 2  :desc. Insert citation :CIT :ECIT
:first.      :CIT.                          :cursor. 5
:row.        text=:ECIT.
:cmd.        DATE     :min. 2  :desc. Insert document date
:first.      :DATE.                         :cursor. 6
:cmd.        DD       :min. 2  :desc. Insert definition description
:first.      :DD.                           :cursor. 4
:cmd.        DDHD     :min. 3  :desc. Insert definition description heading
:first.      :DDHD.definition desc heading  :cursor. 6
:cmd.        DL       :min. 2  :desc. Insert definition list
:first.      :DL.                           :cursor. 3
:row.        text=:DTHD.definition term heading
:row.        text=:DDHD.definition desc heading
:row.        text=:DT.definition term
:row.        text=:DD.
:row.        text=:EDL.
:cmd.        DOCNUM   :min. 2  :desc. Insert document number
:first.      :DOCNUM.document number        :cursor. 8
:cmd.        DT       :min. 2  :desc. Insert definition term
:first.      :DT.definition term            :cursor. 4
:row.        text=:DD.
:cmd.        DTHD     :min. 3  :desc. Insert definition term heading
:first.      :DTHD.definition term heading  :cursor. 6
:cmd.        FIG      :min. 3  :desc. Insert figure
:first.      :FIG.                          :cursor. 4
:row.        text=put text here
:row.        text=:FIGCAP.figure caption
:row.        text=:FIGDESC.
:row.        text=:EFIG.
:cmd.        FIGLIST  :min. 4  :desc. Insert list of illustrations
:first.      :FIGLIST.
:cmd.        FIGREF   :min. 4  :desc. Insert figure reference
:first.      :FIGREF REFID=.                :cursor. 14
:cmd.        FN       :min. 2  :desc. Insert footnote
:first.      :FN.                           :cursor. 4
:row.        text=:EFN.
:cmd.        FNREF    :min. 3  :desc. Insert footnote reference
:first.      :FNREF REFID=.                 :cursor. 13
:cmd.        FRONTM   :min. 2  :desc. Insert front matter section
:first.      :FRONTM.
:cmd.        GD       :min. 2  :desc. Insert glossary definition
:first.      :GD.glossary def               :cursor. 4
:cmd.        GDOC     :min. 3  :desc. Insert general document
:first.      :GDOC.
:row.        text=:FRONTM.
:row.        text=:TITLEP.
:row.        text=:TITLE.document title     :cursor. 7
:row.        text=:DOCNUM.document number
:row.        text=:DATE.
:row.        text=:AUTHOR.author name
:row.        text=:ADDRESS.
:row.        text=:ALINE.address line
:row.        text=:EADDRESS.
:row.        text=:ETITLEP.
:row.        text=:ABSTRACT.
:row.        text=:PREFACE.
:row.        text=:TOC.
:row.        text=:FIGLIST.
:row.        text=:TLIST.
:row.        text=:BODY.
:row.        text=:APPENDIX.
:row.        text=:BACKM.
:row.        text=:INDEX.
:row.        text=:EGDOC.
:cmd.        GL       :min. 2  :desc. Insert glossary list
:first.      :GL.                           :cursor. 3
:row.        text=:GT.glossary term
:row.        text=:GD.glossary def
:row.        text=:EGL.
:cmd.        GT       :min. 2  :desc. Insert glossary term
:first.      :GT.glossary term              :cursor. 4
:row.        text=:GD.glossary def
:cmd.        H        :min. 1  :desc. Insert heading level n, specified as :Hn, n=0-6
:level.      0 6
:first.      :H%n.                          :cursor. 4
:cmd.        HDREF    :min. 3  :desc. Insert heading reference
:first.      :HDREF REFID=.                 :cursor. 13
:cmd.        HP       :min. 2  :desc. Insert highlighted phrase level n, specified as :HPn, n=0-3
:level.      0 3
:first.      :HP%n.                         :cursor. 5
:row.        text=:EHP%n.
:cmd.        I        :min. 1  :desc. Insert index entry level n, specified as :In, n=1-3
:level.      1 3
:first.      :I%n.                          :cursor. 4
:cmd.        IH       :min. 2  :desc. Insert index header level n, specified as :IHn, n=1-3
:level.      1 3
:first.      :IH%n.                         :cursor. 5
:cmd.        INDEX    :min. 3  :desc. Insert index
:first.      :INDEX.
:cmd.        IREF     :min. 2  :desc. Insert index entry reference
:first.      :IREF REFID=.                  :cursor. 12
:cmd.        LI       :min. 2  :desc. Insert list item
:first.      :LI.                           :cursor. 4
:cmd.        LIREF    :min. 3  :desc. Insert list item reference
:first.      :LIREF REFID=.                 :cursor. 13
:cmd.        LP       :min. 2  :desc. Insert list part
:first.      :LP.                           :cursor. 4
:cmd.        LQ       :min. 2  :desc. Insert long quotation
:first.      :LQ.                           :cursor. 4
:row.        text=:ELQ.
:cmd.        NOTE     :min. 2  :desc. Insert note
:first.      :NOTE.                         :cursor. 6
:cmd.        OL       :min. 2  :desc. Insert ordered list
:first.      :OL.                           :cursor. 3
:row.        text=:LI.
:row.        text=:EOL.
:cmd.        P        :min. 1  :desc. Insert paragraph
:first.      :P.                            :cursor. 3
:cmd.        PC       :min. 2  :desc. Insert paragraph continuation
:first.      :PC.                           :cursor. 4
:cmd.        PREFACE  :min. 3  :desc. Insert preface
:first.      :PREFACE.
:cmd.        PSC      :min. 2  :desc. Insert process-specific control
:first.      :PSC PROC=''.                  :cursor. 11
:row.        text=contents
:row.        text=:EPSC.
:cmd.        Q        :min. 1  :desc. Insert quoted phrase
:first.      :Q.                            :cursor. 3
:row.        text=:EQ.
:cmd.        RDEF     :min. 2  :desc. Insert row definition
:first.      :RDEF ID=.                     :cursor. 9
:cmd.        ROW      :min. 2  :desc. Insert table row
:first.      :ROW.
:row.        text=:C.                       :cursor. 3
:cmd.        SL       :min. 2  :desc. Insert simple list
:first.      :SL.                           :cursor. 3
:row.        text=:LI.
:row.        text=:ESL.
:cmd.        TABLE    :min. 3  :desc. Insert table
:first.      :TABLE REFID=.                 :cursor. 13
:row.        text=:ROW.
:row.        text=:C.
:row.        text=:TCAP.table caption
:row.        text=:ETABLE.
:cmd.        TCAP     :min. 2  :desc. Insert table caption
:first.      :TCAP.table caption            :cursor. 6
:cmd.        TDESC    :min. 2  :desc. Insert table description
:first.      :TDESC.                        :cursor. 7
:cmd.        TFT      :min. 2  :desc. Insert table footer
:first.      :TFT.
:row.        text=:C.                       :cursor. 3
:row.        text=:ETFT.
:cmd.        THD      :min. 2  :desc. Insert table header
:first.      :THD.
:row.        text=:C.                       :cursor. 3
:row.        text=:ETHD.
:cmd.        TITLE    :min. 5  :desc. Insert document title
:first.      :TITLE.document title          :cursor. 7
:cmd.        TITLEP   :min. 6  :desc. Insert title page
:first.      :TITLEP.
:row.        text=:TITLE.document title     :cursor. 7
:row.        text=:DOCNUM.document number
:row.        text=:DATE.
:row.        text=:AUTHOR.author name
:row.        text=:ETITLEP.
:cmd.        TLIST    :min. 2  :desc. Insert list of tables
:first.      :TLIST.
:cmd.        TNOTE    :min. 2  :desc. Insert table note
:first.      :TNOTE.                        :cursor. 7
:row.        text=:ETNOTE.
:cmd.        TOC      :min. 2  :desc. Insert table of contents
:first.      :TOC.
:cmd.        TREF     :min. 2  :desc. Insert table reference
:first.      :TREF REFID=.                  :cursor. 12
:cmd.        UL       :min. 2  :desc. Insert unordered list
:first.      :UL.                           :cursor. 3
:row.        text=:LI.
:row.        text=:EUL.
:cmd.        XMP      :min. 2  :desc. Insert example
:first.      :XMP.                          :cursor. 5
:row.        text=:EXMP.
