/* REXX */
/* Profile to set up the PFXxxx prefix macros */

/* trace ?i */
HLAs  = ASM HLASM
REXXs = CMD EXEC KEX REXX SPF THE THERC XED XEDIT
GMLs  = SCRIPT
OOREXXs = CLS ORX REX
NETREXXs = NRX
PLIs  = PLI PL1
Ftype = translate(Ftype.1())
select
   when wordpos(Ftype,HLAs) > 0 then do
      Pfx_ops = '..'                               ,
                'cline'  /* alias of .. for THE */ ,
                'asml'   /* ASMLEAVE in DO      */ ,
                'asmle'  /* ASMLEAVE in DO      */ ,
                'case'                            ,
                'casee'  /* CASENTRY            */ ,
                'clc'    /* Column lower case   */ ,
                'cl'     /* Column lower case   */ ,
                'clo'    /* Column lower case   */ ,
                'clow'   /* Column lower case   */ ,
                'cuc'    /* Column upper case   */ ,
                'cu'     /* Column upper case   */ ,
                'cup'    /* Column upper case   */ ,
                'cupp'   /* Column upper case   */ ,
                'cuppe'  /* Column upper case   */ ,
                'do'                               ,
                'doex'   /* DOEXIT   in DO      */ ,
                'doexi'  /* DOEXIT   in DO      */ ,
                'else'                             ,
                'elsei'  /* ELSEIF              */ ,
                'endif'                            ,
                'exiti'  /* EXITIF   in SEARCH  */ ,
                'if'                               ,
                'itera'  /* ITERATE  in DO      */ ,
                'orels'  /* ORELSE   in SEARCH  */ ,
                'other'  /* OTHRWISE in SELECT  */ ,
                'othrw'  /* OTHRWISE in SELECT  */ ,
                'ri'                               ,
                'ric'                              ,
                'sea'    /* STRTSRCH            */ ,
                'sear'   /* STRTSRCH            */ ,
                'searc'  /* STRTSRCH            */ ,
                'sel'    /* SELECT              */ ,
                'sele'   /* SELECT              */ ,
                'selec'  /* SELECT              */ ,
                'sta'    /* STAR                */ ,
                'star'   /* STAR                */ ,
                'strts'  /* STRTSRCH            */ ,
                'unst'   /* UNSTAR              */ ,
                'unsta'  /* UNSTAR              */ ,
                'whe'    /* WHEN     in SELECT  */ ,
                'when'   /* WHEN     in SELECT  */
      Macro_name = PFXHLASM
      end
   when wordpos(Ftype,REXXs) > 0 then do
      Pfx_ops = '..'                    ,
                'cline'  /* alias of .. for THE */ ,
                'clc'    /* Column lower case   */ ,
                'cl'     /* Column lower case   */ ,
                'clo'    /* Column lower case   */ ,
                'clow'   /* Column lower case   */ ,
                'cuc'    /* Column upper case   */ ,
                'cu'     /* Column upper case   */ ,
                'cup'    /* Column upper case   */ ,
                'cupp'   /* Column upper case   */ ,
                'cuppe'  /* Column upper case   */ ,
                'do'                               ,
                'iter'   /* ITERATE             */ ,
                'itera'  /* ITERATE             */ ,
                'loc'                              ,
                'if'                               ,
                'lea'    /* LEAVE               */ ,
                'leav'   /* LEAVE               */ ,
                'other'  /* OTHERWISE           */ ,
                'ri'                               ,
                'ri'                               ,
                'ric'                              ,
                'sel'    /* SELECT              */ ,
                'sele'   /* SELECT              */ ,
                'selec'  /* SELECT              */ ,
                'upc'                              ,
                'whe'    /* WHEN                */ ,
                'when'   /* WHEN                */
      Macro_name = PFXREXX
      end
   when wordpos(Ftype,OOREXXs) > 0 then do
      /* ooRexx: the REXX commands plus LOOP and the directives */
      Pfx_ops = '..'                               ,
                'cline'  /* alias of .. for THE */ ,
                'clc'    /* Column lower case   */ ,
                'cl'     /* Column lower case   */ ,
                'clo'    /* Column lower case   */ ,
                'clow'   /* Column lower case   */ ,
                'cuc'    /* Column upper case   */ ,
                'cu'     /* Column upper case   */ ,
                'cup'    /* Column upper case   */ ,
                'cupp'   /* Column upper case   */ ,
                'cuppe'  /* Column upper case   */ ,
                'cla'    /* ::CLASS             */ ,
                'clas'   /* ::CLASS             */ ,
                'class'  /* ::CLASS             */ ,
                'do'                               ,
                'if'                               ,
                'iter'   /* ITERATE             */ ,
                'itera'  /* ITERATE             */ ,
                'lea'    /* LEAVE               */ ,
                'leav'   /* LEAVE               */ ,
                'loc'                              ,
                'loo'    /* LOOP                */ ,
                'loop'   /* LOOP                */ ,
                'met'    /* ::METHOD            */ ,
                'meth'   /* ::METHOD            */ ,
                'metho'  /* ::METHOD            */ ,
                'method' /* ::METHOD            */ ,
                'other'  /* OTHERWISE           */ ,
                'res'    /* ::RESOURCE          */ ,
                'reso'   /* ::RESOURCE          */ ,
                'ri'                               ,
                'ric'                              ,
                'rou'    /* ::ROUTINE           */ ,
                'rout'   /* ::ROUTINE           */ ,
                'routi'  /* ::ROUTINE           */ ,
                'sel'    /* SELECT              */ ,
                'sele'   /* SELECT              */ ,
                'selec'  /* SELECT              */ ,
                'upc'                              ,
                'whe'    /* WHEN                */ ,
                'when'   /* WHEN                */
      Macro_name = PFXOOREXX
      end
   when wordpos(Ftype,NETREXXs) > 0 then do
      /* NetRexx: the REXX commands plus LOOP, CLASS, METHOD, PROPERTIES */
      Pfx_ops = '..'                               ,
                'cline'  /* alias of .. for THE */ ,
                'clc'    /* Column lower case   */ ,
                'cl'     /* Column lower case   */ ,
                'clo'    /* Column lower case   */ ,
                'clow'   /* Column lower case   */ ,
                'cuc'    /* Column upper case   */ ,
                'cu'     /* Column upper case   */ ,
                'cup'    /* Column upper case   */ ,
                'cupp'   /* Column upper case   */ ,
                'cuppe'  /* Column upper case   */ ,
                'cla'    /* CLASS               */ ,
                'clas'   /* CLASS               */ ,
                'class'  /* CLASS               */ ,
                'do'                               ,
                'if'                               ,
                'iter'   /* ITERATE             */ ,
                'itera'  /* ITERATE             */ ,
                'lea'    /* LEAVE               */ ,
                'leav'   /* LEAVE               */ ,
                'loc'                              ,
                'loo'    /* LOOP                */ ,
                'loop'   /* LOOP                */ ,
                'met'    /* METHOD              */ ,
                'meth'   /* METHOD              */ ,
                'metho'  /* METHOD              */ ,
                'method' /* METHOD              */ ,
                'other'  /* OTHERWISE           */ ,
                'prop'   /* PROPERTIES          */ ,
                'prope'  /* PROPERTIES          */ ,
                'ri'                               ,
                'ric'                              ,
                'sel'    /* SELECT              */ ,
                'sele'   /* SELECT              */ ,
                'selec'  /* SELECT              */ ,
                'upc'                              ,
                'whe'    /* WHEN                */ ,
                'when'   /* WHEN                */
      Macro_name = PFXNETREXX
      end
   when wordpos(Ftype,PLIs) > 0 then do
      /* PL/I: the REXX-style commands plus BEGIN and PROCEDURE */
      Pfx_ops = '..'                               ,
                'cline'  /* alias of .. for THE */ ,
                'clc'    /* Column lower case   */ ,
                'cl'     /* Column lower case   */ ,
                'clo'    /* Column lower case   */ ,
                'clow'   /* Column lower case   */ ,
                'cuc'    /* Column upper case   */ ,
                'cu'     /* Column upper case   */ ,
                'cup'    /* Column upper case   */ ,
                'cupp'   /* Column upper case   */ ,
                'cuppe'  /* Column upper case   */ ,
                'beg'    /* BEGIN               */ ,
                'begi'   /* BEGIN               */ ,
                'begin'  /* BEGIN               */ ,
                'do'                               ,
                'if'                               ,
                'iter'   /* ITERATE             */ ,
                'itera'  /* ITERATE             */ ,
                'lea'    /* LEAVE               */ ,
                'leav'   /* LEAVE               */ ,
                'loc'                              ,
                'other'  /* OTHERWISE           */ ,
                'proc'   /* PROCEDURE           */ ,
                'proce'  /* PROCEDURE           */ ,
                'ri'                               ,
                'ric'                              ,
                'sel'    /* SELECT              */ ,
                'sele'   /* SELECT              */ ,
                'selec'  /* SELECT              */ ,
                'upc'                              ,
                'when'   /* WHEN                */
      Macro_name = PFXPLI
      end
   when wordpos(Ftype,GMLs) > 0 then do
      /* GML: the one synonym ":", the tag is the operand; DCF GML
         Starter Set (PFXGMLW is the Waterloo GML version) */
      Pfx_ops    = ':'
      Macro_name = PFXGMLSS
      end
   otherwise
      exit
   end

/* Unlike XEDIT, the names of line macros are case sensitive in THE */
parse source opsys
do i = 1 to words(Pfx_ops)
   Pfx_lc = word(Pfx_ops,i)
   Pfx_uc = translate(Pfx_lc)
   if opsys \= CMS then
      SET PREFIX SYNONYM Pfx_lc Macro_name
   SET PREFIX SYNONYM Pfx_uc Macro_name
   end

